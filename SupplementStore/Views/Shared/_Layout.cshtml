<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - متجر عضلات</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏋️ متجر <span class="text-accent">عضلات</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="تبديل التنقل">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">المتجر</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index" asp-route-category="بروتين">بروتين</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index" asp-route-category="أداء وطاقة">أداء وطاقة</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index" asp-route-category="صحة عامة">صحة عامة</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold text-warning" asp-controller="Admin" asp-action="Index">🛠 الإدارة</a></li>
                    </ul>
                    <form class="d-flex my-2 my-lg-0" asp-controller="Shop" asp-action="Index" method="get" role="search">
                        <input class="form-control form-control-sm ms-2" type="search" name="query" placeholder="ابحث..." aria-label="بحث" style="min-width:150px" />
                        <button class="btn btn-outline-light btn-sm" type="submit">🔍</button>
                    </form>
                    <span class="nav-link text-white-50">🛒 السلة (0)</span>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-dark text-white-50">
        <div class="container py-3 d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; 2026 متجر عضلات للمكملات الغذائية — جميع الحقوق محفوظة</span>
            <a class="text-white-50" asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
