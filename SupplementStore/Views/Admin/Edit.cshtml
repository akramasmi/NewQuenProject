@model SupplementStore.Models.ProductInputModel
@{
    ViewData["Title"] = $"تعديل: {Model.Name}";
    ViewData["Mode"] = "Edit";
}
<div class="container py-4">
    <h1 class="h3 fw-bold mb-4">✏️ تعديل المنتج «@Model.Name»</h1>
    <div class="card shadow-sm border-0"><div class="card-body p-4">
        <partial name="_ProductForm" model="Model" />
    </div></div>
</div>
