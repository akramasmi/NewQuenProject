@model List<SupplementStore.Models.Product>
@{
    ViewData["Title"] = "المتجر";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- الشريط الجانبي -->
        <aside class="col-lg-3">
            <div class="card shadow-sm filter-card">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">تصفية المنتجات</h5>

                    <form asp-action="Index" method="get" class="mb-3">
                        <input type="hidden" name="category" value="@ViewBag.CurrentCategory" />
                        <div class="input-group">
                            <input type="text" name="query" class="form-control"
                                   placeholder="ابحث عن منتج..." value="@ViewBag.Query" />
                            <button class="btn btn-primary" type="submit">🔍</button>
                        </div>
                    </form>

                    <ul class="list-unstyled category-list mb-0">
                        <li>
                            <a asp-action="Index"
                               class="@(string.IsNullOrEmpty(ViewBag.CurrentCategory as string) ? "active" : "")">
                                كل المنتجات (@Model.Count)
                            </a>
                        </li>
                        @foreach (var cat in (List<string>)ViewBag.Categories)
                        {
                            <li>
                                <a asp-action="Index" asp-route-category="@cat" asp-route-query="@ViewBag.Query"
                                   class="@(ViewBag.CurrentCategory == cat ? "active" : "")">@cat</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </aside>

        <!-- شبكة المنتجات -->
        <main class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h2 class="fw-bold mb-0">
                    @(string.IsNullOrEmpty(ViewBag.CurrentCategory as string) ? "جميع المنتجات" : ViewBag.CurrentCategory)
                </h2>
                @if (!string.IsNullOrEmpty(ViewBag.Query as string))
                {
                    <span class="badge bg-secondary fs-6">نتائج البحث عن: @ViewBag.Query</span>
                }
            </div>

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning text-center">
                    😕 لا توجد منتجات مطابقة لبحثك.
                    <a asp-action="Index" class="alert-link">عرض جميع المنتجات</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var product in Model)
                    {
                        <div class="col-6 col-md-4">
                            <partial name="_ProductCard" model="product" />
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>
